<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/feno_primary_dark"
                android:endColor="@color/feno_primary_dark"
                android:angle="0" />
            <corners android:radius="12dp"/>
        </shape>
    </item>

    <!-- Default State -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/feno_primary_dark"
                android:endColor="@color/feno_primary_dark"
                android:angle="0" />
            <corners android:radius="12dp"/>
        </shape>
    </item>

</selector>