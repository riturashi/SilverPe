                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Address details"
                        android:textColor="#203F63"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Full Address"
                        android:textColor="#303846"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilAddress"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:boxCornerRadiusBottomEnd="7dp"
                        app:boxCornerRadiusBottomStart="7dp"
                        app:boxCornerRadiusTopEnd="7dp"
                        app:boxCornerRadiusTopStart="7dp"
                        app:boxStrokeColor="#7B8794"
                        app:hintTextColor="#203F63">
                        <com.google.android.material.textfield.TextInputEditText
                            android:hint="Full Address"
                            android:id="@+id/etAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:imeOptions="actionNext"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="2"
                            android:textColor="#273444"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Firm Name"
                        android:textColor="#303846"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/firm_name"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:boxCornerRadiusBottomEnd="7dp"
                        app:boxCornerRadiusBottomStart="7dp"
                        app:boxCornerRadiusTopEnd="7dp"
                        app:boxCornerRadiusTopStart="7dp"
                        app:boxStrokeColor="#7B8794"
                        app:hintTextColor="#203F63">
                        <com.google.android.material.textfield.TextInputEditText
                            android:hint="Firm Name"
                            android:id="@+id/etFirmName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:minHeight="48dp"
                            android:textColor="#273444"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <!-- STATE -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="State"
                                android:textColor="#303846"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilState"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxCornerRadiusBottomEnd="7dp"
                                app:boxCornerRadiusBottomStart="7dp"
                                app:boxCornerRadiusTopEnd="7dp"
                                app:boxCornerRadiusTopStart="7dp"
                                app:boxStrokeColor="#7B8794"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/etState"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Select state"
                                    android:inputType="none"
                                    android:maxLines="1"
                                    android:minHeight="48dp"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="8dp"
                                    android:textColor="#273444"
                                    android:textSize="13sp" />

                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <!-- CITY -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="6dp"
                                android:text="City"
                                android:textColor="#303846"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilCity"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:boxCornerRadiusBottomEnd="7dp"
                                app:boxCornerRadiusBottomStart="7dp"
                                app:boxCornerRadiusTopEnd="7dp"
                                app:boxCornerRadiusTopStart="7dp"
                                app:boxStrokeColor="#7B8794"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/etCity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="Select city"
                                    android:inputType="none"
                                    android:maxLines="1"
                                    android:minHeight="48dp"
                                    android:paddingStart="12dp"
                                    android:paddingEnd="8dp"
                                    android:textColor="#273444"
                                    android:textSize="13sp" />

                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                    </LinearLayout>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pincode"
                        android:textColor="#303846"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPincode"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:boxCornerRadiusBottomEnd="7dp"
                        app:boxCornerRadiusBottomStart="7dp"
                        app:boxCornerRadiusTopEnd="7dp"
                        app:boxCornerRadiusTopStart="7dp"
                        app:boxStrokeColor="#7B8794"
                        app:counterEnabled="true"
                        app:counterMaxLength="6"
                        app:hintTextColor="#203F63">
                        <com.google.android.material.textfield.TextInputEditText
                            android:hint="Pincode"
                            android:id="@+id/etPincode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="6"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:textColor="#273444"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>


                </LinearLayout>

<!--            </com.google.android.material.card.MaterialCardView>-->
        </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeColor="#E1E5EB"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_marginBottom="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/feno_primary"
                android:text="Add User"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="7dp"
                app:elevation="0dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp">
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="#203F63" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
