<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Main Page Content ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:id="@+id/header_all"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/feno_primary"
            android:elevation="4dp"
            android:paddingHorizontal="15dp">

            <ImageView
                android:translationY="10dp"
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:padding="8dp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/white" />

            <TextView
                android:translationY="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Scan QR to Withdraw"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/white"
                android:gravity="center"
                android:padding="20dp">

                <!-- Timer at the TOP of the page -->
                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="8dp">

                    <com.silverpe.instantpay.CircularTimerView
                        android:id="@+id/timerProgress"
                        android:layout_width="84dp"
                        android:layout_height="84dp" />

                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="30"
                        android:textColor="#2E7D32"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:text="Time Remaining"
                    android:textColor="#9E9E9E"
                    android:textSize="11sp" />

                <!-- ===== QR Card ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp"
                    app:strokeColor="#E8EEFF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@color/white"
                        android:padding="24dp">

                        <!-- QR Image (logo gets drawn into its centre in code) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/white"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp"
                            app:strokeColor="#E8EEFF"
                            app:strokeWidth="2dp">

                            <ImageView
                                android:id="@+id/imgQr"
                                android:layout_width="210dp"
                                android:layout_height="210dp"
                                android:padding="12dp" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Security Note -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:cardBackgroundColor="#E8F5E9"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:paddingVertical="8dp"
                                android:text="🔒  Scan with any NPCI-registered UPI app"
                                android:textColor="#2E7D32"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>

                        <!-- UPI App Logos (4 shown here) + View All -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginTop="14dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:src="@drawable/ic_paytm" />

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="match_parent"
                                android:layout_marginHorizontal="8dp"
                                android:src="@drawable/ic_gpay" />

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:src="@drawable/ic_upi" />

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:src="@drawable/ic_bhim" />
                        </LinearLayout>

                        <!-- Tap this to open the full supported-apps image -->
                        <TextView
                            android:id="@+id/tvViewAllApps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:padding="6dp"
                            android:text="View All Supported Apps →"
                            android:textColor="@color/feno_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <!-- Amount -->
                        <TextView
                            android:id="@+id/tvAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="₹0"
                            android:textColor="@color/feno_primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <!-- Customer Mobile - kept since our flow needs it shown -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Customer Mobile: "
                                android:textColor="#9E9E9E"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tvMobile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="9999999999"
                                android:textColor="#374151"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Waiting strip -->
                <LinearLayout
                    android:id="@+id/layoutWaiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#FFF8E1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:indeterminateTint="#F9A825" />

                    <TextView
                        android:id="@+id/tvWaiting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waiting for payment confirmation..."
                        android:textColor="#E65100"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Check Status button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckStatus"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="12dp"
                    android:text="CHECK STATUS"
                    android:visibility="gone"
                    app:cornerRadius="14dp" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- ===== Full-screen "Supported UPI Apps" overlay ===== -->
    <!-- Hidden by default. centerCrop is deliberate - it fills the
         whole screen and lets the edges crop off rather than
         letterboxing the image. -->
    <FrameLayout
        android:id="@+id/overlaySupportedApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgFullScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Supported UPI Apps" />

        <ProgressBar
            android:id="@+id/progressFullScreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/white" />

        <TextView
            android:id="@+id/btnCloseFullImage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:background="#55000000"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

</FrameLayout>