<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    card_view:cardCornerRadius="10dp"
    card_view:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Status + Date -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_status_success"
                android:paddingLeft="12dp"
                android:paddingTop="4dp"
                android:paddingRight="12dp"
                android:paddingBottom="4dp"
                android:text="Success"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="--"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Amount (big, prominent) -->
        <TextView
            android:id="@+id/txtAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="₹0"
            android:textColor="@color/feno_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Bene Name -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Beneficiary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:text=":" />

            <TextView
                android:id="@+id/txtBeneName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#111827"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mobile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Mobile"
                android:textStyle="bold" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:text=":" />

            <TextView
                android:id="@+id/txtMobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#111827"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- IFSC (Express DMT has no bank_name from the API — IFSC shown instead) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="IFSC"
                android:textStyle="bold" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:text=":" />

            <TextView
                android:id="@+id/txtIfsc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#111827"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Account -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Account No."
                android:textStyle="bold" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:text=":" />

            <TextView
                android:id="@+id/txtAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#111827"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- UTR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="UTR No."
                android:textStyle="bold" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:text=":" />

            <TextView
                android:id="@+id/txtUtr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#111827"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Txn Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:text="Txn Type"
                android:textStyle="bold" />

            <TextView
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:text=":" />

            <TextView
                android:id="@+id/txtTxnType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="#111827"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
