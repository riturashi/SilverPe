<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/feno_primary"
        android:paddingHorizontal="15dp">

        <!-- Back Button -->
        <ImageView
            android:translationY="10dp"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/white" />

        <!-- Title -->
        <TextView
            android:translationY="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="My Bank Accounts"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- SUBTITLE (optional clean look) -->
    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:text="Select account for settlement"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <!-- Recycler View -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBankList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtSubtitle"
        android:layout_marginTop="5dp"
        android:clipToPadding="false"
        android:padding="10dp"
        android:paddingBottom="90dp" />

    <!-- Loader -->
    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <!-- Add Bank Button -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnAddBank"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="80dp"
        android:text="Add New Account"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/feno_primary"
        app:cornerRadius="30dp"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/white" />

</RelativeLayout>