<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- HEADER -->

    <RelativeLayout
        android:id="@+id/header_all"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/feno_primary"
        android:paddingHorizontal="15dp">

        <ImageView
            android:translationY="10dp"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            app:tint="@color/white" />

        <TextView
            android:translationY="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Jio eKYC Authentication"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- BODY -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- MERCHANT DETAILS -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="MERCHANT DETAILS"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Loading..."
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMobile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="+91 0000000000"
                        android:textColor="#475569" />

                    <TextView
                        android:id="@+id/tvAadhar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Aadhaar: **** **** 0000"
                        android:textColor="#475569" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- NOTE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="#FFF9C4"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="#FBC02D" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Note: eKYC authentication is required for secure onboarding and identity verification.\n\nनोट: सुरक्षित ऑनबोर्डिंग और पहचान सत्यापन के लिए eKYC ऑथेंटिकेशन आवश्यक है।"
                    android:textColor="#7B1FA2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- FINGER IMAGE -->

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:layout_marginTop="25dp"
                android:src="@drawable/ic_newfingerprint"
                android:scaleType="centerInside" />

        </LinearLayout>

    </ScrollView>

    <!-- BOTTOM SECTION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="15dp"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- DEVICE TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Select Device"
            android:textAllCaps="true"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- DEVICE SELECTOR -->

        <LinearLayout
            android:id="@+id/btnChangeDevice"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_left_rounded_gray"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="15dp"
            android:paddingEnd="15dp">

            <ImageView
                android:id="@+id/imgSelectedDevice"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_device" />

            <TextView
                android:id="@+id/tvDeviceShortName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Mantra L1"
                android:textColor="@color/feno_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- CONSENT -->

        <CheckBox
            android:id="@+id/cbConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:checked="true"
            android:text="I hereby voluntarily give my consent to BharatDigiCash to capture and use my fingerprint biometric for Jio Payment Bank eKYC authentication and UIDAI verification, as per regulatory guidelines."
            android:textColor="#475569"
            android:textSize="12sp" />

        <!-- BUTTON -->

        <androidx.appcompat.widget.AppCompatButton
            android:layout_marginBottom="50dp"
            android:id="@+id/btnScanNow"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_btn_blue"
            android:text="TAP TO SCAN"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>