<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardUser"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E6E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="#EEF2FF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="R"
                    android:textColor="#4F46E5"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Test"
                    android:textColor="#101828"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvParentUserId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="FENO0024"
                    android:textColor="#667085"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/tvMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:drawableStart="@android:drawable/ic_menu_call"
                    android:drawablePadding="6dp"
                    android:drawableTint="#667085"
                    android:gravity="center_vertical"
                    android:text="9999999999"
                    android:textColor="#667085"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_user_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Active"
                android:textColor="#15803D"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#EEF0F4" />

        <!-- EMAIL -->
        <TextView
            style="@style/UserLabel"
            android:layout_marginTop="12dp"
            android:text="Email" />

        <TextView
            android:id="@+id/tvEmail"
            style="@style/UserValue"
            android:text="—" />


        <!-- REGISTERED MOBILE | DOB -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UserLabel"
                    android:text="Registered mobile" />

                <TextView
                    android:id="@+id/tvRegMobile"
                    style="@style/UserValue"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UserLabel"
                    android:text="Date of birth" />

                <TextView
                    android:id="@+id/tvDob"
                    style="@style/UserValue"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <!-- PAN | AADHAAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UserLabel"
                    android:text="PAN" />

                <TextView
                    android:id="@+id/tvPan"
                    style="@style/UserValue"
                    android:text="—" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/UserLabel"
                    android:text="Aadhaar" />

                <TextView
                    android:id="@+id/tvAadhaar"
                    style="@style/UserValue"
                    android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <!-- ADDRESS BLOCK -->
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#F8F9FC"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/UserLabel"
                android:text="Address" />

            <TextView
                android:id="@+id/tvAddress"
                style="@style/UserValue"
                android:text="—" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/UserLabel"
                        android:text="State" />

                    <TextView
                        android:id="@+id/tvState"
                        style="@style/UserValue"
                        android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/UserLabel"
                        android:text="City" />

                    <TextView
                        android:id="@+id/tvCity"
                        style="@style/UserValue"
                        android:text="—" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:orientation="vertical">

                    <TextView
                        style="@style/UserLabel"
                        android:text="Pincode" />

                    <TextView
                        android:id="@+id/tvPincode"
                        style="@style/UserValue"
                        android:text="—" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>