<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical">

    <!-- ═══════════════════════ PREMIUM HEADER ═══════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/feno_primary"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/header_all"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:translationY="10dp"
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_back_white"
                app:tint="@color/white" />

            <LinearLayout
                android:translationY="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.15"
                    android:text="FINO"
                    android:textColor="#99FFFFFF"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="AEPS Service"
                    android:textColor="@color/white"
                    android:textSize="17sp" />
            </LinearLayout>

        </RelativeLayout>

        <!-- ── Service Tabs ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="2dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/tabCW"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="9dp"
                android:background="@color/white"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💸"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTabCW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Cash Withdraw"
                    android:textColor="@color/feno_primary"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabBE"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="9dp"
                android:background="#33FFFFFF"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTabBE"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Balance Inquiry"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabMS"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="9dp"
                android:background="#33FFFFFF"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTabMS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Mini Statement"
                    android:textColor="#CCFFFFFF"
                    android:textSize="10sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════ SCROLL BODY ══════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ── MOBILE CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="CUSTOMER MOBILE"
                    android:textColor="#8895B3"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutMobile"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/feno_primary"
                    app:boxStrokeWidthFocused="2dp"
                    app:counterEnabled="true"
                    app:counterMaxLength="10"
                    app:hintTextColor="@color/feno_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMobile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter 10-digit number"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:textColor="#111111"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ── AADHAAR CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="AADHAAR NUMBER"
                    android:textColor="#8895B3"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutAadhar"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxStrokeColor="@color/feno_primary"
                    app:boxStrokeWidthFocused="2dp"
                    app:counterEnabled="true"
                    app:counterMaxLength="12"
                    app:hintTextColor="@color/feno_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAadhar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="XXXX  XXXX  XXXX"
                        android:inputType="number"
                        android:letterSpacing="0.1"
                        android:maxLength="12"
                        android:textColor="#111111"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Aadhaar 3-segment progress bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <View
                        android:id="@+id/aadharSeg1"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:alpha="0.15"
                        android:background="@color/feno_primary" />

                    <View
                        android:id="@+id/aadharSeg2"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:alpha="0.15"
                        android:background="@color/feno_primary" />

                    <View
                        android:id="@+id/aadharSeg3"
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:alpha="0.15"
                        android:background="@color/feno_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── BANK CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="BANK"
                    android:textColor="#8895B3"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:id="@+id/layoutBankPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_outlined_field">

                    <TextView
                        android:id="@+id/etBank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/ivBankArrow"
                        android:background="@null"
                        android:clickable="false"
                        android:focusable="false"
                        android:hint="Select your bank"
                        android:textColor="#111111"
                        android:textColorHint="#AAAAAA"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageView
                        android:id="@+id/ivBankArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_keyboard_arrow_down"
                        app:tint="#8895B3" />
                </RelativeLayout>
            </LinearLayout>

            <!-- ── AMOUNT CARD (GONE for BE & MS) — includes OTP status row ── -->
            <LinearLayout
                android:id="@+id/layoutAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="AMOUNT"
                    android:textColor="#8895B3"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="₹"
                        android:textColor="#8895B3"
                        android:textSize="22sp"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/feno_primary"
                        app:boxStrokeWidthFocused="2dp"
                        app:hintTextColor="@color/feno_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etAmount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Enter amount"
                            android:inputType="number"
                            android:textColor="#111111"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Quick Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/chip500"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="#E8F0FE"
                        android:gravity="center"
                        android:text="₹500"
                        android:textColor="@color/feno_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip1000"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="#E8F0FE"
                        android:gravity="center"
                        android:text="₹1,000"
                        android:textColor="@color/feno_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip2000"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="#E8F0FE"
                        android:gravity="center"
                        android:text="₹2,000"
                        android:textColor="@color/feno_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip5000"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="#E8F0FE"
                        android:gravity="center"
                        android:text="₹5,000"
                        android:textColor="@color/feno_primary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- ══ OTP STATUS ROW — NPCI: CW above ₹5000 ══ -->
                <LinearLayout
                    android:id="@+id/layoutOtpStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#FFF6E9"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvOtpStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ OTP required for withdrawal above ₹5,000"
                        android:textColor="#B35400"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendOtp"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="8dp"
                        android:layout_gravity="end"
                        android:minWidth="0dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Send OTP"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:backgroundTint="@color/feno_primary"
                        app:cornerRadius="8dp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── DEVICE CARD ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="BIOMETRIC DEVICE"
                    android:textColor="#8895B3"
                    android:textSize="10sp"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:id="@+id/layoutDevicePicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:background="@drawable/bg_outlined_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/etDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@+id/ivDeviceArrow"
                        android:background="@null"
                        android:clickable="false"
                        android:focusable="false"
                        android:hint="Select biometric device"
                        android:textColor="#111111"
                        android:textColorHint="#AAAAAA"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageView
                        android:id="@+id/ivDeviceArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_keyboard_arrow_down"
                        app:tint="#8895B3" />
                </RelativeLayout>
            </LinearLayout>

            <!-- ── CONSENT ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EEF3FF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="22dp">

                <CheckBox
                    android:id="@+id/cbConsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:lineSpacingExtra="3dp"
                    android:text="I hereby provide my informed consent to BharatDigiCash to use my Aadhaar details for this transaction."
                    android:textColor="#374899"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ── PROCEED BUTTON ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProceed"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-bold"
                android:letterSpacing="0.08"
                android:text="SCAN &amp; PROCEED"
                android:textSize="15sp"
                app:backgroundTint="@color/feno_primary"
                app:cornerRadius="14dp"
                app:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:text="🔒  256-bit encrypted  •  RBI compliant"
                android:textColor="#8895B3"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>