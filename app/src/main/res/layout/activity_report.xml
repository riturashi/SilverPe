                        android:lines="2"
                        android:text="Micro ATM"
                        android:textColor="@color/text_header"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </GridLayout>
        </com.google.android.material.card.MaterialCardView>

