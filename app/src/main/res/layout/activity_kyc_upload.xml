<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <!-- HEADER -->
    <RelativeLayout
        android:id="@+id/header_all"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/feno_primary"
        android:padding="15dp">

        <ImageView
            android:translationY="10dp"
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:padding="8dp"
            android:src="@drawable/ic_back_arrow"
            android:tint="@color/white" />

        <TextView
            android:translationY="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Upload KYC"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </RelativeLayout>

    <!-- CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- AADHAR FRONT -->
            <LinearLayout
                android:id="@+id/aadharfront"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Aadhar Front"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Please upload clearly visible"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgAadharFront"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_aadharfront"/>
            </LinearLayout>

            <!-- AADHAR BACK -->
            <LinearLayout
                android:id="@+id/aadharback"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Aadhar Back"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Please upload clearly visible"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgAadharBack"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_aadharback"/>
            </LinearLayout>

            <!-- PAN -->
            <LinearLayout
                android:id="@+id/pancard"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload PAN Card"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/imgPan"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_pan"/>
            </LinearLayout>

            <!-- BANK -->
            <LinearLayout
                android:id="@+id/bankpassbook"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload Bank Passbook/Cheque"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/imgBank"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_bank"/>
            </LinearLayout>

            <!-- ADDRESS FRONT -->
            <LinearLayout
                android:id="@+id/addressproof"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Address Proof Front"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Driving Licence / Electricity / Voter ID"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgAddressFront"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_drivinglicence"/>
            </LinearLayout>

            <!-- ADDRESS BACK -->
            <LinearLayout
                android:id="@+id/addressproofback"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Address Proof Back"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Driving Licence / Electricity / Voter ID"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgAddressBack"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_drivinglicence"/>
            </LinearLayout>
            <!-- PHOTO -->
            <LinearLayout
                android:id="@+id/photo"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upload Photo"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capture clear selfie"
                        android:textSize="12sp"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgPhoto"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_user"/>
            </LinearLayout>
            <!-- SHOP INNER -->
            <LinearLayout
                android:id="@+id/cardShopInner"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload Shop Inner"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/imgShopInner"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_store"/>
            </LinearLayout>

            <!-- SHOP OUTER -->
            <LinearLayout
                android:id="@+id/cardShopOuter"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_dotted_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Upload Shop Outer"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <ImageView
                    android:id="@+id/imgShopOuter"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_store"/>
            </LinearLayout>

            <!-- BUTTON -->
            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:text="SUBMIT"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/bg_btn_blue"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>